<!-- roslaunch hydra_dsg_builder d455_outdoor_dsg_builder.launch start_visualizer:=true enable_rectification:=false enable_dsg_lcd:=true verbosity:=2 min_glog_level:=0 -->
<!-- roslaunch hydra_dsg_builder master_d455.launch start_visualizer:=true enable_rectification:=false enable_dsg_lcd:=true verbosity:=2 min_glog_level:=0 -->
<launch>
    <!-- robot configuration -->
    <arg name="robot_id"                  default="0"/>
    <arg name="sensor_frame"              default="left_cam"/>
    <arg name="d455_configuration"        default="d455_center"/>
    <arg name="d455_prefix"               default="cam_d455"/>
    <arg name="use_mask"                  default="true"/>
    <arg name="depth_mask_filename"       default="a1_center_mask_roi_640.png"/>
    <!-- <arg name="start_visualizer"          default="false"/> -->
    <!-- <arg name="start_visualizer_quiet"    default="false"/> -->

    <!-- camera settings -->
    <arg name="rgb_info_topic"            default="/$(arg d455_prefix)/color/camera_info"/>
    <arg name="rgb_topic"                 default="/$(arg d455_prefix)/color/image_raw"/>
<!--     <arg name="depth_info_topic_input"    default="/$(arg d455_prefix)/aligned_depth_to_color/camera_info"/>
    <arg name="depth_topic_input"         default="/$(arg d455_prefix)/aligned_depth_to_color/image_raw"/> -->
    <arg name="depth_info_topic_input"    default="/$(arg d455_prefix)/depth/camera_info"/>
    <arg name="depth_topic_input"         default="/$(arg d455_prefix)/depth/image_rect_raw"/>
    <arg name="pointcloud_topic"          default="/semantic_pointcloud"/>
    <arg name="start_depth_manager"       default="true"/>
    <arg name="enable_rectification"      default="false"/>

    <arg name="depth_topic"               default="/depth_registered/image_rect"  if="$(arg enable_rectification)"/>
    <arg name="depth_info_topic"          default="/depth_registered/camera_info" if="$(arg enable_rectification)"/>
    <arg name="depth_topic"               default="$(arg depth_topic_input)"      unless="$(arg enable_rectification)"/>
    <arg name="depth_info_topic"          default="$(arg depth_info_topic_input)" unless="$(arg enable_rectification)"/>

    <arg name="depth_mask_topic"          default="/$(arg d455_prefix)/depth_masked/image_raw"  if="$(arg use_mask)"/>
    <arg name="depth_mask_topic"          default="$(arg depth_topic)"                          unless="$(arg use_mask)"/>

    <!-- semantics settings -->
    <arg name="semantic_topic"            default="semantic/image_raw"/>
    <arg name="model_name"                default="mobilenetv2_360_640"/>
    <arg name="model_path"                default="$(find semantic_recolor)/models/$(arg model_name).onnx"/>
    <arg name="engine_path"               default="$(find semantic_recolor)/engines/$(arg model_name).trt"/>
    <arg name="segmenter_config"          default="$(find semantic_recolor)/config/$(arg model_name).yaml"/>
    <arg name="dataset_name"              default="ade150_expanded_config"/>
    <arg name="color_config"              default="$(find semantic_recolor)/config/colors/$(arg dataset_name).yaml"/>
    <arg name="throttle_semantics"        default="true"/>
    <arg name="throttle_hz"               default="5.0"/>

    <!-- hydra  settings-->
    <arg name="config_dir"                default="$(find hydra_dsg_builder)/config/d455"/>
    <arg name="dsg_output_dir"            default="$(find hydra_dsg_builder)/output"/>
    <arg name="dsg_output_prefix"         default="d455"/>
    <arg name="typology_dir"              default="$(find hydra_dsg_builder)/config/d455"/>
    <arg name="typology_config"           default="d455_outdoor_typology.yaml"/>
    <arg name="semantic_map_dir"          default="$(find semantic_recolor)/config/colors"/>
    <arg name="semantic_map_file"         default="ade150_expanded_config.csv"/>
    <arg name="semantic_map_path"         default="$(arg semantic_map_dir)/$(arg semantic_map_file)"/>
    <arg name="rviz_dir"                  default="$(find hydra_dsg_builder)/rviz"/>
    <arg name="rviz_file"                 default="d455.rviz"/>
    <arg name="debug"                     default="false"/>
    <arg name="publish_archived"          default="true"/>
    <arg name="sim_time_required"         default="true"/>
    <arg name="use_semantics"             default="true"/>
    <arg name="use_gt_poses"              default="false"/>
    <arg name="use_gt_frame"              default="true"/>

    <param name="use_sim_time" value="$(arg sim_time_required)"/>
    <include file="$(find hydra_utils)/launch/gt_pose/$(arg d455_configuration)_gt_pose.launch" if="$(arg use_gt_frame)">
        <arg name="sensor_frame" value="$(arg sensor_frame)"/>
    </include>

    <node pkg="nodelet" type="nodelet" name="nodelet_manager_depth"
          args="manager"
          output="screen"
          required="true"/>

    <node pkg="nodelet" type="nodelet" name="depth_rectifier"
          args="load depth_image_proc/register nodelet_manager_depth --no-bond"
          output="screen"
          required="true">
        <remap from="rgb/camera_info" to="$(arg rgb_info_topic)"/>
        <remap from="depth/image_rect" to="$(arg depth_topic_input)"/>
        <remap from="depth/camera_info" to="$(arg depth_info_topic_input)"/>
    </node>

    <include file="$(find hydra_utils)/launch/includes/rgbd_to_pointcloud.xml" pass_all_args="true"
             unless="$(arg use_semantics)"/>

    <include file="$(find semantic_recolor)/launch/master_semantic_recolor_pointcloud.launch" pass_all_args="true"
             if="$(arg use_semantics)"/>

    <node pkg="nodelet" type="nodelet" name="depth_mask"
          args="load hydra_utils/mask nodelet_manager --no-bond"
          output="screen"
          required="true"
          if="$(arg use_mask)">
<!--         <remap from="depth/image_raw"             to="$(arg depth_topic)"/>
        <remap from="depth_masked/image_raw"      to="/$(arg d455_prefix)/depth_masked/image_raw"/> -->
        <remap from="depth/image_raw"             to="$(arg depth_topic)"/>
        <remap from="depth_masked/image_raw"      to="$(arg depth_mask_topic)"/>
        <param name="mask_path"                   value="$(find hydra_utils)/resources/$(arg depth_mask_filename)"/>
    </node>

    <include file="$(find hydra_topology)/launch/hydra_topology.launch" pass_all_args="true">
        <arg name="semantic_color_path"           value="$(arg semantic_map_path)"/>
        <arg name="config_dir"                    value="$(find hydra_topology)/config"/>
        <arg name="glog_dir"                      value="$(find hydra_topology)/glogs"/>
        <arg name="debug"                         value="$(arg debug)"/>
        <arg name="publish_archived"              value="$(arg publish_archived)"/>
        <arg name="use_gt_poses"                  value="$(arg use_gt_poses)"/>
        <arg name="config"                        value="d455_topology_config.yaml"/>
        <arg name="semantic_config"               default="ade150_semantic_config.yaml"/>
    </include>

    <include file="$(find hydra_dsg_builder)/launch/dsg_builder.launch" pass_all_args="true">
        <arg name="use_oriented_bounding_boxes"   value="true"/>
        <arg name="use_gt_frame"                  value="false"/>
    </include>

    <node pkg="hydra_utils" type="pose_graph_publisher_node" name="pose_graph_publisher_node"
          required="true"
          output="log">
          <param name="use_pointcloud_time"       value="true"/>
          <param name="world_frame"               value="world"/>
          <param name="robot_frame"               value="$(arg sensor_frame)"/>
          <param name="robot_id"                  value="$(arg robot_id)"/>
          <remap from="~pose_graph"               to="/kimera_vio_ros/pose_graph_incremental"/>
          <remap from="~time_point"               to="/pointcloud_time"/>
    </node>

    <!-- jackal_voc.yml -->
    <!-- ORBvoc.yml -->
    <node pkg="kimera_vio_ros" type="lcd_only_node" name="lcd_only_node"
          args="--vocabulary_path=$(find kimera_vio)/vocabulary/jackal_voc.yml"
          output="log">
        <param name="use_pointcloud_time"         value="true"/>
        <param name="params_path"                 value="$(find hydra_utils)/config/d455_vio"/>
        <param name="robot_id"                    value="$(arg robot_id)"/>
        <param name="log_output"                  value="false"/>
        <remap from="~color/image_raw"            to="$(arg rgb_topic)"/>
        <!-- <remap from="~depth/image_raw"            to="$(arg depth_topic)"/> -->
        <remap from="~depth/image_raw"            to="$(arg depth_mask_topic)"/>
        <remap from="~time_point"                 to="/pointcloud_time"/>
        <remap from="~bow_vectors"                to="/kimera_vio_ros/bow_query"/>
        <remap from="~register_lcd_frames"        to="/kimera_vio_ros/kimera_vio_ros_node/register_lcd_frames"/>
    </node>

</launch>
