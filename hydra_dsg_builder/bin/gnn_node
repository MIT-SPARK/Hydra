#!/usr/bin/env python3
"""Run inference on received scene graphs."""
import spark_dsg as dsg
import numpy as np
import pathlib
import logging
import pickle
import torch
import click


@click.command()
@click.argument("network")
@click.option("--recv-url", "-r", default="tcp://127.0.0.1:8001")
@click.option("--send-url", "-s", default="tcp://127.0.0.1:8002")
@click.option("--num-threads", "-t", default=2)
@click.option("--poll-time-ms", default=10)
def main(network, recv_url, send_url, num_threads, poll_time_ms):
    """Run everything."""
    logging.basicConfig(
        format="[%(asctime)s %(levelname)s] %(message)s", level=logging.DEBUG
    )

    network_path = pathlib.Path(network).expanduser().absolute()
    with network_path.open("rb") as fin:
        model = pickle.load(fin)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model.to(device)

    logging.info(f"setting up sender @ {send_url}")
    sender = dsg.DsgSender(send_url)

    logging.info(f"setting up receiver @ {recv_url}")
    receiver = dsg.DsgReceiver(recv_url)

    # attrs = dsg.SemanticNodeAttributes()
    # print(sgl.__file__)

    while True:
        if not receiver.recv(poll_time_ms):
            continue

        logging.info(f"curr nodes: {receiver.graph.num_nodes(False)}")

        #         torch_graph = convert_to_torch_data(
        # input_graph, semantic_embedding_dict, np.zeros(300), add_edge_attr=True
        # )

        # with torch.no_grad():
        # pred = model(torch_graph.to(device))
        # print(pred)

        G = dsg.DynamicSceneGraph()
        sender.send(G)


if __name__ == "__main__":
    main()
