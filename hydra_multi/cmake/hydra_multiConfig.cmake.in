@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

get_filename_component(hydra_multi_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

find_dependency(config_utilities REQUIRED)
find_dependency(Eigen3 REQUIRED)
find_dependency(GTSAM REQUIRED)
find_dependency(hydra REQUIRED)
find_dependency(kimera_pgmo REQUIRED)
find_dependency(spark_dsg REQUIRED)

if(NOT TARGET hydra_multi::hydra_multi)
  include("${hydra_multi_CMAKE_DIR}/hydra_multiTargets.cmake")
endif()

set(hydra_multi_LIBRARIES hydra_multi::hydra_multi)
check_required_components(hydra_multi)
